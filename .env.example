# Port the HTTP server listens on
PORT=3000

# Application environment: development | production | test
NODE_ENV=development

# PostgreSQL connection string used by the running application.
# On Neon, use the pooled connection string (hostname contains "-pooler").
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# Direct (non-pooled) PostgreSQL connection string, used only by `prisma migrate deploy`.
# On Neon, use the direct connection string (no "-pooler" in the hostname) -
# Prisma Migrate needs session-level locks that don't work through a pooler.
# For a local database without pooling, this is the same value as DATABASE_URL.
DIRECT_URL="postgresql://user:password@host:5432/database?schema=public"

# Origin of the portfolio frontend allowed via CORS
FRONTEND_URL="http://localhost:4200"

# LinkedIn OpenID Connect application credentials
LINKEDIN_CLIENT_ID="your-linkedin-client-id"
LINKEDIN_CLIENT_SECRET="your-linkedin-client-secret"
LINKEDIN_CALLBACK_URL="http://localhost:3000/api/v1/auth/linkedin/callback"

# Secret used to sign application session JWTs (minimum 32 characters)
AUTH_JWT_SECRET="replace-with-a-random-string-of-at-least-32-characters"
